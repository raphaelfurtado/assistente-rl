# Copie este arquivo para .env.local e preencha.
# Na Vercel, cadastre as mesmas variáveis em Project Settings → Environment Variables.

# Chave da API da OpenAI (obrigatória para as camadas 2 e 3; sem ela o assistente roda só com regras)
OPENAI_API_KEY=

# Modelo usado na classificação e nas respostas. Use um modelo pequeno e barato disponível na sua conta.
OPENAI_MODEL=gpt-4o-mini

# Senha da área /admin. Vazio = admin desligado.
ADMIN_PASSWORD=

# Supabase (recomendado): guarda as edições do /admin, os casos encaminhados e a busca semântica (pgvector).
# Project Settings → API Keys. A chave secreta fica SÓ no servidor; nunca use NEXT_PUBLIC_ com ela.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Só para rodar as migrations (npm run db:migrar): connection string com a senha do banco.
SUPABASE_DB_URL=

# Alternativa ao Supabase: Upstash Redis (Vercel → Storage → Upstash preenche sozinho).
# Localmente, sem estas variáveis, o admin salva em .data/config.json.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Sites autorizados a embutir o widget, separados por espaço. Vazio = qualquer site (só para testes).
WIDGET_ALLOWED_ORIGINS=
