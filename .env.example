# Copie este arquivo para .env.local e preencha.
# Na Vercel, cadastre as mesmas variáveis em Project Settings → Environment Variables.

# Chave da API da OpenAI (obrigatória para as camadas 2 e 3; sem ela o assistente roda só com regras)
OPENAI_API_KEY=

# Modelo usado na classificação e nas respostas. Use um modelo pequeno e barato disponível na sua conta.
OPENAI_MODEL=gpt-4o-mini

# Confiança mínima para a Camada 3 responder sozinha (abaixo disso, vai para humano)
CONFIDENCE_THRESHOLD=0.6

# Sites autorizados a embutir o widget, separados por espaço. Vazio = qualquer site (só para testes).
WIDGET_ALLOWED_ORIGINS=
